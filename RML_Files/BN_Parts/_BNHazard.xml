      <constant string="Hypocenter" />
    </property>
    <property name="ConditionalProbabilityTable">
      <constant string="HypocenterCPT" />
    </property>
    <property name="StateBoundsTable">
      <read column="Ranges" />
    </property>
  </instantiate>

  <import from="../../Database/bayesian_network/source_cpt.csv" name="SCPT" />

  <instantiate class="RConditionalProbabilityTable" comment="Source Node" default="SCPT">

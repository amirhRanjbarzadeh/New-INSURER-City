<?xml version="1.0" encoding="UTF-8"?>
<rml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" error="d" warning="d" object="d" xsi:noNamespaceSchemaLocation="../../Dependencies/Rxsd_V4.5.2.xsd">

  <import from="../../Database/bayesian_network/city_grid_vertices_180.csv" name="HGV" />
  <import from="../../Database/bayesian_network/city_grid_180.csv" name="HG" group="BNGroup"/>

  <instantiate class="RLocation" default="HGV" comment="Hazard grid cell vertex locations">
    <property name="ObjectName">
      <constant string="_Loc" />
      <read column="name" />
      <constant string="Point" />
      <read column="vertex" />
    </property>
    <property name="Latitude">
      <read column="lat" />
    </property>
    <property name="Longitude">
      <read column="lon" />
    </property>
  </instantiate>

  <instantiate class="RLocation" default="HG" comment="Hazard grid site locations" group="BNGroup">
    <property name="ObjectName">
      <constant string="_Loc" />
      <read column="name" />
    </property>
    <property name="Latitude">
      <read column="lat" />
    </property>
    <property name="Longitude">
      <read column="lon" />
    </property>
  </instantiate>
  
  <write string="// Source Grids" />

  <instantiate class="RSourceGriddingModel" default="LS" comment="Line Sources' grid">
    <property name="ObjectName">
      <read column="fault_source_id" />
      <constant string="GriddingModel" />
    </property>
    <property name="LocationModel">
      <read column="fault_source_id" />
      <constant string="SimpleFaultModel" />
    </property>
    <property name="NumberOfDivisions">
      <read column="meshSize" />
    </property>
    <property name="UpperDepth">
      <constant string="_" />
      <read column="fault_source_id" />
      <constant string="UpperSeismogenicDepth" />
    </property>
    <property name="LowerDepth">
      <constant string="_" />
      <read column="fault_source_id" />
      <constant string="LowerSeismogenicDepth" />
    </property>
  </instantiate>

  <instantiate class="RSourceGriddingModel" default="AS" comment="Area Sources' grid">
    <property name="ObjectName">
      <read column="area_source_id" />
      <constant string="GriddingModel" />
    </property>
    <property name="LocationModel">
      <read column="area_source_id" />
      <constant string="AreaModel" />
    </property>
    <property name="NumberOfDivisions">
      <read column="meshSize" />
    </property>
    <property name="UpperDepth">
      <constant string="_" />
      <read column="area_source_id" />
      <constant string="UpperSeismogenicDepth" />
    </property>
    <property name="LowerDepth">
      <constant string="_" />
      <read column="area_source_id" />
      <constant string="LowerSeismogenicDepth" />
    </property>
  </instantiate>
  
</rml>

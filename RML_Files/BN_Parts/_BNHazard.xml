<?xml version="1.0" encoding="UTF-8"?>
<rml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" error="d" warning="d" object="d" xsi:noNamespaceSchemaLocation="../../Dependencies/Rxsd_V4.5.2.xsd">

  <import from="../../Database/bayesian_network/city_grid_vertices_180.csv" name="HGV" />
  <import from="../../Database/bayesian_network/city_grid_180.csv" name="HG" group="BNGroup"/>

  <import from="../../Database/hazard/eq_fault_grid.csv" name="LS" />
  <import from="../../Database/hazard/eq_area_grid.csv" name="AS" />

  <instantiate class="RLocation" default="HGV" comment="Hazard grid cell vertex locations">
    <property name="ObjectName">
      <constant string="_Loc" />
      <read column="name" />
      <constant string="Point" />
      <read column="vertex" />
    </property>
    <property name="Latitude">
      <read column="lat" />
    </property>
    <property name="Longitude">
      <read column="lon" />
    </property>
  </instantiate>

  <instantiate class="RLocation" default="HG" comment="Hazard grid site locations" group="BNGroup">
    <property name="ObjectName">
      <constant string="_Loc" />
      <read column="name" />
    </property>
    <property name="Latitude">
      <read column="lat" />
    </property>
    <property name="Longitude">
      <read column="lon" />
    </property>
  </instantiate>

  <write string="// Mesh bookkeeping" />

  <table name="LSMesh">
    <formula expression="m" outputColumnsName="MeshCount" default="LS">
      <column name="m" column="meshSize" split=";" applyFunction="product" />
    </formula>
  </table>

  <table name="ASMesh">
    <formula expression="m" outputColumnsName="MeshCount" default="AS">
      <column name="m" column="meshSize" split=";" applyFunction="product" />
    </formula>
  </table>

  <table name="TMCTotal">
    <function name="sumValues()" outputColumnsName="Total">
      <column name="a" source="LSMesh" column="MeshCount" />
      <column name="b" source="ASMesh" column="MeshCount" />
    </function>
  </table>

  <table name="TMC">
    <formula expression="t-1" outputColumnsName="Sum" default="TMCTotal">
      <column name="t" column="Total" />
    </formula>
  </table>

  <table name="LSStart">
    <function name="cumulative()" outputColumnsName="StartingIndex" default="LSMesh">
      <column name="Values" column="MeshCount" />
    </function>
  </table>

  <table name="ASStart">
    <function name="cumulative()" outputColumnsName="StartingIndex" default="ASMesh">
      <column name="Values" column="MeshCount" />
      <column name="Offset" source="LSMesh" column="MeshCount" />
    </function>
  </table>

  <write string="// Source Grids" />

  <instantiate class="RSourceGriddingModel" default="LS" comment="Line Sources' grid">
    <property name="ObjectName">
      <read column="fault_source_id" />
      <constant string="GriddingModel" />
    </property>
    <property name="LocationModel">
      <read column="fault_source_id" />
      <constant string="SimpleFaultModel" />
    </property>
    <property name="NumberOfDivisions">
      <read column="meshSize" />
    </property>
    <property name="UpperDepth">
      <constant string="_" />
      <read column="fault_source_id" />
      <constant string="UpperSeismogenicDepth" />
    </property>
    <property name="LowerDepth">
      <constant string="_" />
      <read column="fault_source_id" />
      <constant string="LowerSeismogenicDepth" />
    </property>
  </instantiate>

  <instantiate class="RSourceGriddingModel" default="AS" comment="Area Sources' grid">
    <property name="ObjectName">
      <read column="area_source_id" />
      <constant string="GriddingModel" />
    </property>
    <property name="LocationModel">
      <read column="area_source_id" />
      <constant string="AreaModel" />
    </property>
    <property name="NumberOfDivisions">
      <read column="meshSize" />
    </property>
    <property name="UpperDepth">
      <constant string="_" />
      <read column="area_source_id" />
      <constant string="UpperSeismogenicDepth" />
    </property>
    <property name="LowerDepth">
      <constant string="_" />
      <read column="area_source_id" />
      <constant string="LowerSeismogenicDepth" />
    </property>
  </instantiate>

  <table name="LSGridList">
    <function name="repeat()" outputColumnsName="GridList" separator=";"
      pattern="{v}GriddingModel_Grid{i}_" start="1" default="LSMesh">
      <column name="Counts" column="MeshCount" />
      <column name="Values" source="LS" column="fault_source_id" />
    </function>
  </table>

  <table name="ASGridList">
    <function name="repeat()" outputColumnsName="GridList" separator=";"
      pattern="{v}GriddingModel_Grid{i}_" start="1" default="ASMesh">
      <column name="Counts" column="MeshCount" />
      <column name="Values" source="AS" column="area_source_id" />
    </function>
  </table>
  
</rml>

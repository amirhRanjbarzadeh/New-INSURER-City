<?xml version="1.0" encoding="UTF-8"?>
<rml error="Errors/insurer_city.txt" warning="Warnings/insurer_city.txt"
  object="../Analysis/insurer_city.txt"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../Dependencies/Rxsd_V4.5.2.xsd" openFile="true">

  
  <import from="../Dependencies/analysis_option.csv" name="AnalysisOptions" />

  <config source="AnalysisOptions">
    <cell column="number_of_samples" row="2">
      <save name="NoS" />
    </cell>
    <cell column="preferred_number_of_cdf_points" row="2">
      <save name="prefPoint" />
    </cell>
    <cell column="saving_sample_interval" row="2">
      <save name="savInt" />
    </cell>
    <cell column="number_of_threads" row="2">
      <save name="thrdCnt" />
    </cell>
    <cell column="report_ram_usage_interval" row="2">
      <save name="ramInt" />
    </cell>
    <cell column="power_Network" row="2">
      <case value="Dummy">
        <skip targetGroup="PNGroup" />
        <skip targetGroup="HospitalGroup" />
      </case>
      <case value="Full">
        <skip targetGroup="DummyPNGroup" />
      </case>
    </cell>
    <cell column="water_Network" row="2">
      <case value="Dummy">
        <skip targetGroup="WNGroup" />
        <skip targetGroup="HospitalGroup" />
      </case>
      <case value="Full">
        <skip targetGroup="DummyWNGroup" />
      </case>
    </cell>
    <cell column="bayesian_network" row="2">
      <case value="FALSE">
        <skip targetGroup="BNGroup" />
      </case>
    </cell>
  </config>

  <import from="../Database/insurer_city/Subblock.csv" name="SB" />

  <import from="../Database/insurer_city/PowerStation.csv" name="PS" group="PNGroup" />
  <import from="../Database/insurer_city/PowerLine.csv" name="PL" group="PNGroup" />
  <import from="../Database/insurer_city/PowerLine_Maneuver.csv" name="PL_M" group="PNGroup" />

  <import from="../Database/insurer_city/WaterStation.csv" name="WS" group="WNGroup" />
  <import from="../Database/insurer_city/WSDNLocsAndTypes.csv" name="WSDNLT" group="WNGroup" />
  <import from="../Database/insurer_city/WaterPipeline.csv" name="WPl" group="WNGroup" />


  <write string="//This File is generated by RML" />
  <write string=" " />

  <write string="ThreadCount ref::thrdCnt" />
  <write string=" " />

  <instantiate class="RTime">
    <property name="ObjectName">
      <constant string="_Time" />
    </property>
    <property name="CurrentValue">
      <constant string="43543" />
    </property>
  </instantiate>
  
  <instantiate class="RContinuousRandomVariable">
    <property name="ObjectName">
      <constant string="_EarthquakeOccurrenceDate" />
    </property>
    <property name="DistributionType">
      <constant string="Uniform (a, b)" />
    </property>
    <property name="Parameter1">
      <constant string="0" />
    </property>
    <property name="Parameter2">
      <constant string="365" />
    </property>
  </instantiate>

  <instantiate class="RConstant" comment="Interest Rate">
    <property name="ObjectName">
      <constant string="_InterestRate" />
    </property>
    <property name="CurrentValue">
      <constant string="0" />
    </property>
  </instantiate>

  <instantiate class="RConstant" comment="Constants">
    <property name="ObjectName">
      <constant string="_CZero" />
    </property>
    <property name="CurrentValue">
      <constant string="0" />
    </property>
  </instantiate>

  <instantiate class="RConstant">
    <property name="ObjectName">
      <constant string="_CHalf" />
    </property>
    <property name="CurrentValue">
      <constant string="0.5" />
    </property>
  </instantiate>

  <instantiate class="RConstant">
    <property name="ObjectName">
      <constant string="_COne" />
    </property>
    <property name="CurrentValue">
      <constant string="1.0" />
    </property>
  </instantiate>

  <instantiate class="RConstant">
    <property name="ObjectName">
      <constant string="_C999" />
    </property>
    <property name="CurrentValue">
      <constant string="999" />
    </property>
  </instantiate>



  <import from="../Database/bayesian_network/city_grid_180.csv" name="HG" group="BNGroup"/>
  <instantiate class="RLocation" default="HG" comment="Hazard grid site locations" group="BNGroup">
    <property name="ObjectName">
      <constant string="_Loc" />
      <read column="name" />
    </property>
    <property name="Latitude">
      <read column="lat" />
    </property>
    <property name="Longitude">
      <read column="lon" />
    </property>
  </instantiate>

  <write string="// #1 Hazard Models" />
  <include from="./Main/_TimeBased.xml" />

  <write string="// #2 Power Network Models" />
  <include from="./Main/_PowerNetwork.xml" group="PNGroup" />

  <write string="// #3 Water Network Models" />
  <include from="./Main/_WaterNetwork.xml" group="WNGroup" />

  <include from="./BayesianNetwork.xml" group="BNGroup" />
</rml>
